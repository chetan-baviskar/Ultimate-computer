# API server configuration for the Ultimate Computer website
# Copy this file to server/.env and fill in your actual values.

# API server port
# Use a port that no OTHER local project serves. Another app on this machine
# (Renuka Auto Parts) listens on :5000; on Windows two Node servers can bind the
# same port simultaneously, so a collision sends the frontend's /api requests to
# the wrong backend instead of crashing — keep this in sync with
# `server.proxy.target` in vite.config.js.
PORT=5001

# Comma-separated list of allowed CORS origins (your frontend dev server + production URL)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Secret used to sign login sessions (JWT).
# Reserved for the next authentication integration — no auth route reads it yet.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long a login session stays valid (e.g. 7d, 12h, 30m)
JWT_EXPIRES_IN=7d

# Self-healing Firestore channel: how often the watchdog probes Firestore and
# rebuilds the Admin SDK channel when it goes stale (the long-uptime
# "16 UNAUTHENTICATED" failure mode). 0 disables the watchdog.
FIRESTORE_WATCHDOG_INTERVAL_MS=300000
# Minimum seconds between two rebuild attempts (no rebuild storms)
FIRESTORE_RESTART_MIN_INTERVAL_MS=30000

# Administrator provisioning (SERVER-SIDE ONLY, Firebase Admin SDK).
# The two values below are read by the local script only; they are never sent
# to a browser, never returned by an API route and never logged:
#   npm run provision:admin          # provision from the two values below
#   npm run provision:admin:check    # read-only verification
# Public registration can NEVER create an admin (role is fixed server-side).
# ADMIN_EMAIL accepts a comma-separated list; only the FIRST address is
# provisioned (it is the canonical login).
ADMIN_EMAIL=you@example.com
# INITIAL password for that account (change it after first sign-in, or rotate
# with: npm run provision:admin -- --set-password)
ADMIN_PASSWORD=
