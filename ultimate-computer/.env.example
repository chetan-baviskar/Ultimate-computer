# Ultimate Computer — frontend environment
# Copy this file to .env and fill in your values.

# Base URL of the Express API server (server/ folder).
# Leave EMPTY in development — Vite proxies /api/* to http://localhost:5001 (see server.proxy in vite.config.js).
# In production set this to your deployed API URL.
VITE_API_URL=

# Firebase Web SDK (authentication).
# OPTIONAL overrides — the existing project configuration for
# ultimate-computer-e2a91 is already committed in src/config/firebase.js, so
# these can stay empty unless a deployment needs to point elsewhere.
# An API key only identifies the project; it is public by design and grants no
# data access on its own (Firebase Authentication + server-side ID-token
# verification + Firestore rules do that).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
